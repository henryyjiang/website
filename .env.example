# Copy to .env.local for local development, and set the same values in Vercel's
# project settings for production. .env.local is gitignored; this file is not, and
# must never hold a real value.
#
# Everything here is optional. The site builds and renders with none of it set —
# the features that need it are simply absent. See docs/CONTENT.md § About.

# MyAnimeList, for the Blog tab's watchlist rows (what Henry is watching, and the
# last thing he finished). Without it those two rows do not render; everything else
# on the tab is unaffected.
#
# Get one by registering an application at https://myanimelist.net/apiconfig —
# "other" is the right app type, and only the Client ID is needed. There is no
# OAuth here: the site reads one public list and never acts as Henry, so there is
# no token to store or refresh.
#
# The other half of this setting is MAL_USERNAME in content/about.ts, which is
# public and so lives in content rather than in a secret. Both are required, and
# the list has to be public on MyAnimeList or the API answers 403.
MAL_CLIENT_ID=

# The canonical origin, for the link preview. Open Graph and Twitter cards are read
# by scrapers that do not resolve relative URLs, so Next needs an absolute origin to
# build the card's image URL against (`metadataBase`).
#
# Leave it unset and it resolves itself: Vercel's own
# VERCEL_PROJECT_PRODUCTION_URL on a deployment, localhost under `npm run dev`. That
# is correct from the first deploy, so there is nothing to do here until a custom
# domain is attached — at which point set this to it (https://example.com, no
# trailing slash) so previews and production both advertise the real one rather than
# the .vercel.app host. See lib/site.ts and docs/DEPLOYMENT.md.
NEXT_PUBLIC_SITE_URL=
