# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/
build/
next-env.d.ts

# Vercel
.vercel

# Art inbox (art/). Scene layers and objects ARE tracked — they are a handful of
# files and they are the scene. These are not:
#
#   - character frame sequences and raw video, because committing a frame
#     sequence is what inflated the old repo's history to 100 MB (72 MB of it
#     the same frames committed repeatedly). The packed atlas under
#     public/scene/ is committed instead, so a clean clone still builds.
#   - reference material, which is never shipped.
#
# See art/character/README.md and docs/ANIMATION.md.
art/character/sequence/*
!art/character/sequence/.gitkeep
art/character/video/*
!art/character/video/.gitkeep
art/reference/*
!art/reference/.gitkeep

# Source art files, wherever they land
*.psd
*.psb
*.ai
*.aep
*.blend
*.blend1
*.clip

# Legacy assets from the previous site, kept on disk as reference but not tracked.
# assets/video/ is the 173-frame PNG character sequence (34 MB) whose loose-frame
# approach caused the old animation bug and inflated the old repo to 100 MB; it is
# replaced by a packed atlas in Phase 5. glitch.mp4 is the retro intro, dropped per
# docs/DESIGN.md. See docs/ANIMATION.md.
assets/video/
assets/glitch.mp4

# Env
.env
.env*.local

# macOS
.DS_Store

# Editors
.idea/
.vscode/
*.swp

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
